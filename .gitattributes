# Large binary artifacts — Git LFS
# Activate with: `git lfs install` once per machine, then `git lfs migrate import --include="*.safetensors,*.bz2"` to rewrite history.
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.bz2         filter=lfs diff=lfs merge=lfs -text
*.bin         filter=lfs diff=lfs merge=lfs -text
*.pt          filter=lfs diff=lfs merge=lfs -text
*.gguf        filter=lfs diff=lfs merge=lfs -text

# Tokenizer JSON — text but big; keep as text so diffs work, but mark for line-ending normalization.
*.json        text eol=lf

# Rust source — normalize line endings.
*.rs          text eol=lf
*.toml        text eol=lf
*.md          text eol=lf

# Lockfiles — committed, do not normalize.
Cargo.lock    text eol=lf -diff
